# cis-ssh.rules — expected SSH daemon configuration (CIS Benchmark v14.0 aligned).
# Format: key=value. Values are matched against sshd_config directives.
# Edit these to match your environment, then run `mb audit run`.
# Full v14.0 control mapping: see rules/cis-v14.0/5-access.rules (section 5.1).

PermitRootLogin=no
PasswordAuthentication=no
Port=2222
AllowUsers=*
MaxAuthTries=3
LoginGraceTime=30
PubkeyAuthentication=yes
X11Forwarding=no
AllowTcpForwarding=no
ClientAliveInterval=300
ClientAliveCountMax=0
PermitEmptyPasswords=no
Protocol=2
# CIS v14.0 additions (section 5.1):
PermitTunnel=no
PermitAgentForwarding=no
HostbasedAuthentication=no
GSSAPIAuthentication=no
KerberosAuthentication=no
StrictModes=yes
LogLevel=VERBOSE
IgnoreRhosts=yes
# Strong ciphers / MACs / KEX (CIS v14.0 5.1.8-5.1.10):
Ciphers=chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs=hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
KexAlgorithms=curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
HostKeyAlgorithms=ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256
MaxStartups=10:30:60
MaxSessions=10
Banner=/etc/issue.net
