# 1-initial-setup.rules — CIS Benchmark v14.0, section 1: Initial Setup.
# Covers filesystem configuration, software updates, mandatory access control,
# process accounting, cron, sudo, time sync, and warning banners.
#
# Format: <control_id>|<key>|<expected>|<severity>|<fix_script>
#   control_id  — CIS v14.0 control number (e.g. 1.1.1.1)
#   key         — audit check key (matched by modules/cis-benchmark.sh)
#   expected    — expected value (string comparison unless noted)
#   severity    — info|low|medium|high|critical
#   fix_script  — path under fixes/ (empty = manual remediation)
#
# Section 1.1 — Filesystem
1.1.1.1|fs_cramfs|removed|low|fixes/cis-permissions-fix.sh --remove-cramfs
1.1.1.2|fs_freevxfs|removed|low|fixes/cis-permissions-fix.sh --remove-freevxfs
1.1.1.3|fs_hfs|removed|low|fixes/cis-permissions-fix.sh --remove-hfs
1.1.1.4|fs_hfsplus|removed|low|fixes/cis-permissions-fix.sh --remove-hfsplus
1.1.1.5|fs_jffs2|removed|low|fixes/cis-permissions-fix.sh --remove-jffs2
1.1.1.6|fs_ufs|removed|low|fixes/cis-permissions-fix.sh --remove-ufs
1.1.2|fs_tmp_mounted|yes|medium|fixes/cis-permissions-fix.sh --mount-tmp
1.1.3|fs_tmp_nosuid|yes|medium|fixes/cis-permissions-fix.sh --tmp-nosuid
1.1.4|fs_tmp_nodev|yes|medium|fixes/cis-permissions-fix.sh --tmp-nodev
1.1.5|fs_tmp_noexec|yes|low|fixes/cis-permissions-fix.sh --tmp-noexec
1.1.6|fs_dev_shm_mounted|yes|medium|fixes/cis-permissions-fix.sh --mount-devshm
1.1.7|fs_dev_shm_nosuid|yes|medium|fixes/cis-permissions-fix.sh --devshm-nosuid
1.1.8|fs_dev_shm_nodev|yes|medium|fixes/cis-permissions-fix.sh --devshm-nodev
1.1.9|fs_dev_shm_noexec|yes|low|fixes/cis-permissions-fix.sh --devshm-noexec
1.1.10|fs_var_separate|yes|medium|
1.1.11|fs_var_tmp_bind|yes|medium|fixes/cis-permissions-fix.sh --bind-var-tmp
1.1.12|fs_var_log_separate|yes|medium|
1.1.13|fs_var_log_audit_separate|yes|medium|
1.1.14|fs_home_separate|yes|medium|
1.1.15|fs_home_nodev|yes|medium|fixes/cis-permissions-fix.sh --home-nodev
1.1.16|fs_removable_nodev|yes|medium|fixes/cis-permissions-fix.sh --removable-nodev
1.1.17|fs_removable_nosuid|yes|medium|fixes/cis-permissions-fix.sh --removable-nosuid
1.1.18|fs_removable_noexec|yes|low|fixes/cis-permissions-fix.sh --removable-noexec
1.1.19|fs_sticky_bit|yes|medium|fixes/cis-permissions-fix.sh --sticky-bit
1.1.20|fs_var_perm|755|medium|fixes/cis-permissions-fix.sh --var-perm
1.1.21|fs_var_log_perm|750|medium|fixes/cis-permissions-fix.sh --var-log-perm
1.1.22|fs_var_log_audit_perm|750|medium|fixes/cis-permissions-fix.sh --var-log-audit-perm
1.1.23|fs_home_perm|750|medium|fixes/cis-permissions-fix.sh --home-perm
1.1.24|fs_apt_files_perm|644|low|fixes/cis-permissions-fix.sh --apt-perm
1.1.25|fs_apt_files_owner|root|low|fixes/cis-permissions-fix.sh --apt-owner
1.1.26|fs_passwd_file_perm|644|medium|fixes/cis-permissions-fix.sh --passwd-perm
1.1.27|fs_passwd_file_owner|root|medium|fixes/cis-permissions-fix.sh --passwd-owner
1.1.28|fs_group_file_perm|644|medium|fixes/cis-permissions-fix.sh --group-perm
1.1.29|fs_group_file_owner|root|medium|fixes/cis-permissions-fix.sh --group-owner
1.1.30|fs_shadow_file_perm|640|high|fixes/cis-permissions-fix.sh --shadow-perm
1.1.31|fs_shadow_file_owner|root|high|fixes/cis-permissions-fix.sh --shadow-owner
1.1.32|fs_gshadow_file_perm|640|high|fixes/cis-permissions-fix.sh --gshadow-perm
1.1.33|fs_gshadow_file_owner|root|high|fixes/cis-permissions-fix.sh --gshadow-owner
1.1.34|fs_world_writable_sticky|yes|medium|fixes/cis-permissions-fix.sh --world-writable-sticky
1.1.35|fs_unowned_files|none|low|fixes/cis-permissions-fix.sh --unowned-files
1.1.36|fs_ungrouped_files|none|low|fixes/cis-permissions-fix.sh --ungrouped-files
1.1.37|fs_suid_files|reviewed|low|
1.1.38|fs_sgid_files|reviewed|low|

# Section 1.2 — Software updates
1.2.1|apt_sources_configured|yes|medium|
1.2.2|gpg_keys_configured|yes|medium|

# Section 1.3 — Mandatory access control
1.3.1|apparmor_installed|yes|medium|fixes/cis-permissions-fix.sh --enable-apparmor
1.3.2|apparmor_enabled|yes|medium|fixes/cis-permissions-fix.sh --enable-apparmor
1.3.3|apparmor_profiles_enforcing|yes|medium|

# Section 1.4 — Process accounting
1.4.1|auditd_installed|yes|high|fixes/cis-permissions-fix.sh --install-auditd
1.4.2|auditd_enabled|yes|high|fixes/cis-permissions-fix.sh --enable-auditd
1.4.3|auditd_boot_enabled|yes|high|fixes/cis-permissions-fix.sh --enable-auditd
1.4.4|auditd_backlog_limit|8192|medium|fixes/cis-permissions-fix.sh --auditd-backlog

# Section 1.5 — Secure boot settings
1.5.1|bootloader_password|yes|medium|fixes/cis-permissions-fix.sh --bootloader-password
1.5.2|bootloader_config_owner|root|medium|fixes/cis-permissions-fix.sh --bootloader-owner
1.5.3|bootloader_config_perm|400|medium|fixes/cis-permissions-fix.sh --bootloader-perm

# Section 1.6 — Additional process hardening
1.6.1|xdg_runtime_dir|yes|low|
1.6.2|core_dumps_disabled|yes|medium|fixes/cis-permissions-fix.sh --disable-core-dumps
1.6.3|aslr_enabled|yes|medium|fixes/cis-kernel-hardening.sh --aslr
1.6.4|address_space_layout|yes|medium|fixes/cis-kernel-hardening.sh --aslr

# Section 1.7 — Mandatory access control (SELinux/AppArmor)
1.7.1|mac_framework|yes|medium|fixes/cis-permissions-fix.sh --enable-apparmor
1.7.2|mac_enforcing|yes|medium|

# Section 1.8 — Warning banners
1.8.1|motd_configured|yes|low|fixes/cis-permissions-fix.sh --motd-banner
1.8.2|local_login_banner|yes|low|fixes/cis-permissions-fix.sh --login-banner
1.8.3|remote_login_banner|yes|low|fixes/cis-permissions-fix.sh --remote-banner
1.8.4|banner_perm|644|low|fixes/cis-permissions-fix.sh --banner-perm
1.8.5|banner_owner|root|low|fixes/cis-permissions-fix.sh --banner-owner

# Section 1.9 — Time synchronization
1.9.1|time_sync_installed|yes|medium|fixes/cis-permissions-fix.sh --install-timesync
1.9.2|time_sync_enabled|yes|medium|fixes/cis-permissions-fix.sh --enable-timesync
1.9.3|time_sync_running|yes|medium|fixes/cis-permissions-fix.sh --enable-timesync
1.9.4|time_sync_configured|yes|medium|fixes/cis-permissions-fix.sh --configure-timesync

# Section 1.10 — Cron and atd
1.10.1|cron_installed|yes|low|
1.10.2|cron_enabled|yes|low|fixes/cis-permissions-fix.sh --enable-cron
1.10.3|cron_perm|600|low|fixes/cis-permissions-fix.sh --cron-perm
1.10.4|cron_owner|root|low|fixes/cis-permissions-fix.sh --cron-owner
1.10.5|cron_hourly_perm|700|low|fixes/cis-permissions-fix.sh --cron-dir-perm
1.10.6|cron_daily_perm|700|low|fixes/cis-permissions-fix.sh --cron-dir-perm
1.10.7|cron_weekly_perm|700|low|fixes/cis-permissions-fix.sh --cron-dir-perm
1.10.8|cron_monthly_perm|700|low|fixes/cis-permissions-fix.sh --cron-dir-perm
1.10.9|cron_d_perm|700|low|fixes/cis-permissions-fix.sh --cron-dir-perm
1.10.10|atd_restricted|yes|low|fixes/cis-permissions-fix.sh --restrict-atd

# Section 1.11 — sudo configuration
1.11.1|sudo_installed|yes|medium|fixes/cis-permissions-fix.sh --install-sudo
1.11.2|sudoers_use_pty|yes|medium|fixes/cis-permissions-fix.sh --sudo-pty
1.11.3|sudo_log_file|yes|medium|fixes/cis-permissions-fix.sh --sudo-log
1.11.4|sudoers_includes|reviewed|low|
1.11.5|sudoers_perm|440|medium|fixes/cis-permissions-fix.sh --sudoers-perm
1.11.6|sudoers_owner|root|medium|fixes/cis-permissions-fix.sh --sudoers-owner
