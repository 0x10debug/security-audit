# 4-logging.rules — CIS Benchmark v14.0, section 4: Logging and Auditing.
# Covers rsyslog, journald, auditd rules, and log file permissions.
#
# Format: <control_id>|<key>|<expected>|<severity>|<fix_script>

# Section 4.1 — rsyslog
4.1.1|rsyslog_installed|yes|medium|fixes/cis-permissions-fix.sh --install-rsyslog
4.1.2|rsyslog_enabled|yes|medium|fixes/cis-permissions-fix.sh --enable-rsyslog
4.1.3|rsyslog_running|yes|medium|fixes/cis-permissions-fix.sh --enable-rsyslog
4.1.4|rsyslog_config_file|yes|low|fixes/cis-permissions-fix.sh --rsyslog-config
4.1.5|rsyslog_logging_auth|yes|medium|fixes/cis-permissions-fix.sh --rsyslog-auth
4.1.6|rsyslog_logging_all|yes|low|fixes/cis-permissions-fix.sh --rsyslog-all
4.1.7|rsyslog_remote_logging|configured|low|fixes/cis-permissions-fix.sh --rsyslog-remote
4.1.8|rsyslog_perm|640|medium|fixes/cis-permissions-fix.sh --rsyslog-perm
4.1.9|rsyslog_owner|syslog|medium|fixes/cis-permissions-fix.sh --rsyslog-owner

