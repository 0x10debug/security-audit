5.4.6|root_rhosts|absent|high|fixes/cis-permissions-fix.sh --root-rhosts
5.4.7|root_forward|absent|low|fixes/cis-permissions-fix.sh --root-forward
5.4.8|root_login_shell|set|medium|fixes/cis-permissions-fix.sh --root-login-shell
5.4.9|empty_passwords|none|high|fixes/cis-permissions-fix.sh --no-empty-passwords
5.4.10|system_accounts_shell|nologin|high|fixes/cis-permissions-fix.sh --system-accounts-shell
