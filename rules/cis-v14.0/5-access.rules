5.3.2|pass_min_days|1|medium|fixes/cis-permissions-fix.sh --pass-min-days
5.3.3|pass_warn_age|7|low|fixes/cis-permissions-fix.sh --pass-warn-age
5.3.4|pass_inactive_lock|30|medium|fixes/cis-permissions-fix.sh --pass-inactive-lock
5.3.5|pass_min_len|14|high|fixes/cis-permissions-fix.sh --pass-min-len
5.3.6|pass_complexity|yes|high|fixes/cis-permissions-fix.sh --pass-complexity
5.3.7|pass_dcredit|-1|medium|fixes/cis-permissions-fix.sh --pass-dcredit
5.3.8|pass_ucredit|-1|medium|fixes/cis-permissions-fix.sh --pass-ucredit
5.3.9|pass_lcredit|-1|medium|fixes/cis-permissions-fix.sh --pass-lcredit
5.3.10|pass_ocredit|-1|medium|fixes/cis-permissions-fix.sh --pass-ocredit
5.3.11|pass_minclass|4|medium|fixes/cis-permissions-fix.sh --pass-minclass
5.3.12|pass_maxrepeat|3|medium|fixes/cis-permissions-fix.sh --pass-maxrepeat
5.3.13|pass_maxclassrepeat|4|medium|fixes/cis-permissions-fix.sh --pass-maxclassrepeat
5.3.14|pass_gecoscheck|yes|low|fixes/cis-permissions-fix.sh --pass-gecoscheck
5.3.15|pass_dictcheck|yes|medium|fixes/cis-permissions-fix.sh --pass-dictcheck
5.3.16|pass_enforce_for_root|yes|high|fixes/cis-permissions-fix.sh --pass-enforce-root
5.3.17|pass_maxsequence|yes|medium|fixes/cis-permissions-fix.sh --pass-maxsequence
5.3.18|pass_retry|3|low|fixes/cis-permissions-fix.sh --pass-retry
5.3.19|pass_sha512|yes|medium|fixes/cis-permissions-fix.sh --pass-sha512

