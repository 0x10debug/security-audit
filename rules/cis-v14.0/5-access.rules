# 5-access.rules — CIS Benchmark v14.0, section 5: Access, Authentication and Authorization.
# Covers SSH server config, PAM, password policies, user accounts, and session lock.
#
# Format: <control_id>|<key>|<expected>|<severity>|<fix_script>

# Section 5.1 — SSH server configuration
5.1.1|ssh_permitrootlogin|no|high|fixes/cis-ssh-hardening.sh --permit-root-login
5.1.2|ssh_permitemptypasswords|no|high|fixes/cis-ssh-hardening.sh --permit-empty-passwords
5.1.3|ssh_permittunnel|no|medium|fixes/cis-ssh-hardening.sh --permit-tunnel
5.1.4|ssh_sshd_protocol|2|high|fixes/cis-ssh-hardening.sh --protocol
5.1.5|ssh_x11forwarding|no|medium|fixes/cis-ssh-hardening.sh --x11-forwarding
5.1.6|ssh_maxauthtries|3|medium|fixes/cis-ssh-hardening.sh --max-auth-tries
5.1.7|ssh_logingracetime|30|medium|fixes/cis-ssh-hardening.sh --login-grace-time
5.1.8|ssh_ciphers|strong|high|fixes/cis-ssh-hardening.sh --ciphers
5.1.9|ssh_macs|strong|high|fixes/cis-ssh-hardening.sh --macs
5.1.10|ssh_kexalgorithms|strong|high|fixes/cis-ssh-hardening.sh --kex-algorithms
5.1.11|ssh_clientaliveinterval|300|low|fixes/cis-ssh-hardening.sh --client-alive-interval
5.1.12|ssh_clientalivecountmax|0|low|fixes/cis-ssh-hardening.sh --client-alive-countmax
5.1.13|ssh_loglevel|verbose|low|fixes/cis-ssh-hardening.sh --log-level
5.1.14|ssh_ignoreknownhosts|no|low|fixes/cis-ssh-hardening.sh --ignore-known-hosts
5.1.15|ssh_gssapiauthentication|no|low|fixes/cis-ssh-hardening.sh --gssapi
5.1.16|ssh_kerberosauthentication|no|low|fixes/cis-ssh-hardening.sh --kerberos
5.1.17|ssh_strictmodes|yes|medium|fixes/cis-ssh-hardening.sh --strict-modes
5.1.18|ssh_allowusers|set|medium|fixes/cis-ssh-hardening.sh --allow-users
5.1.19|ssh_allowgroups|set|medium|fixes/cis-ssh-hardening.sh --allow-groups
5.1.20|ssh_denyusers|reviewed|low|
5.1.21|ssh_denygroups|reviewed|low|
5.1.22|ssh_passwordauthentication|no|high|fixes/cis-ssh-hardening.sh --password-auth
5.1.23|ssh_pubkeyauthentication|yes|medium|fixes/cis-ssh-hardening.sh --pubkey-auth
5.1.24|ssh_hostbasedauthentication|no|medium|fixes/cis-ssh-hardening.sh --hostbased-auth
5.1.25|ssh_permittcpforwarding|no|medium|fixes/cis-ssh-hardening.sh --permit-tcp-forwarding
5.1.26|ssh_permitagentforwarding|no|medium|fixes/cis-ssh-hardening.sh --permit-agent-forwarding
5.1.27|ssh_port|2222|medium|fixes/cis-ssh-hardening.sh --port
5.1.28|ssh_banner|yes|low|fixes/cis-ssh-hardening.sh --banner
5.1.29|ssh_maxstartups|10:30:60|low|fixes/cis-ssh-hardening.sh --max-startups
5.1.30|ssh_maxsessions|10|low|fixes/cis-ssh-hardening.sh --max-sessions
5.1.31|ssh_logingraceshorts|30|medium|fixes/cis-ssh-hardening.sh --login-grace-time
5.1.32|ssh_compression|no|low|fixes/cis-ssh-hardening.sh --compression
5.1.33|ssh_hostkey_algos|strong|high|fixes/cis-ssh-hardening.sh --hostkey-algos
5.1.34|ssh_hostbasedacceptedkeytypes|strong|medium|fixes/cis-ssh-hardening.sh --hostbased-keytypes

# Section 5.2 — PAM configuration
5.2.1|pam_libs_installed|yes|medium|fixes/cis-permissions-fix.sh --install-pam
5.2.2|pam_common_password|configured|high|fixes/cis-permissions-fix.sh --pam-password
5.2.3|pam_common_auth|configured|high|fixes/cis-permissions-fix.sh --pam-auth
5.2.4|pam_common_account|configured|medium|fixes/cis-permissions-fix.sh --pam-account
5.2.5|pam_common_session|configured|medium|fixes/cis-permissions-fix.sh --pam-session
5.2.6|pam_faillock|yes|high|fixes/cis-permissions-fix.sh --pam-faillock
5.2.7|pam_faillock_deny|5|high|fixes/cis-permissions-fix.sh --pam-faillock-deny
5.2.8|pam_faillock_unlock_time|900|high|fixes/cis-permissions-fix.sh --pam-faillock-unlock
5.2.9|pam_pwhistory|yes|medium|fixes/cis-permissions-fix.sh --pam-pwhistory
5.2.10|pam_pwhistory_remember|5|medium|fixes/cis-permissions-fix.sh --pam-pwhistory-remember
5.2.11|pam_no_root_auth|configured|medium|fixes/cis-permissions-fix.sh --pam-no-root-auth

